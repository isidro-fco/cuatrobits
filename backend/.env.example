PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://cuatrobits:cuatrobits@localhost:5432/cuatrobits
# Sin servidor PostgreSQL: PostgreSQL en WebAssembly guardado en una carpeta local
# DATABASE_URL=pglite://.data/pglite
# Varios orígenes separados por comas, por ejemplo: https://cuatrobits.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Producción con Supabase: verify + el certificado de Supabase (ver DESPLIEGUE.md)
DATABASE_SSL=off
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_POOL_MAX=5
