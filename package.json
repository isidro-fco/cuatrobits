{
  "name": "cuatrobits",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "oxlint -c .oxlintrc.json frontend/src backend/src scripts",
    "lint:fix": "oxlint -c .oxlintrc.json --fix frontend/src backend/src scripts",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx}\" \"backend/src/**/*.ts\" \"frontend/*.ts\" \"backend/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx}\" \"backend/src/**/*.ts\" \"frontend/*.ts\" \"backend/*.ts\" \"scripts/*.mjs\"",
    "verificar:estandar": "node scripts/verificarEstandar.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "oxlint": "1.88.0",
    "prettier": "^3.9.10"
  }
}
